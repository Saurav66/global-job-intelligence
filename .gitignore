# Candidate private profiles and resumes
# Note: Candidate-specific private context, resumes, and contact info must live in the Manus Project, NOT in this public repository.
candidate_private.*
candidate-profile-private.*
/candidate_context.json
/candidate_context.yaml
/candidate_context.md
candidate_context_private.*
